# MongoDB — guarda contas, convites e competicoes (par de usuarios).
# Crie gratis em mongodb.com/cloud/atlas, pegue a "connection string" e
# cole aqui. Sem essa variavel, o app roda local com um "banco" de mentira
# em arquivo (.data/mongo-fallback.json, ignorado pelo git) so pra dev —
# nao funciona em producao.
MONGODB_URI=

# Redis (Upstash) — guarda os dados do dia a dia (treino, refeicoes, agua,
# medidas, composicao corporal...). Crie gratis em
# vercel.com/marketplace/upstash ou upstash.com. Ao instalar a integracao
# Upstash pela Vercel, essas duas variaveis sao preenchidas automaticamente
# no projeto. Para rodar local, copie os valores do painel da Upstash
# (REST URL / REST TOKEN) para um arquivo .env.local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: habilita "tirar foto do alimento e a IA calcula a nutrição" na
# aba Nutrição. Precisa de uma chave da API da Anthropic — console.anthropic.com
# (é uma conta de API separada do plano Claude Pro/claude.ai; o Pro não
# gera essa chave). Sem essa variável, o app mostra um atalho pra analisar
# a foto direto no claude.ai em vez de fazer isso automaticamente.
ANTHROPIC_API_KEY=
